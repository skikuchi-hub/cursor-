# ── 必須 ─────────────────────────────────────────────
# 合言葉（長いランダム文字列）。scripts/install-mac.sh が自動で作る。
# 全部の Mac で同じ値にする（Mac 同士で仕事を回すときに使うため）。
JARVIS_TOKEN=

# この Mac の名前（imac / macbook など。小文字英数字）
JARVIS_MACHINE=imac

# ── よく変えるもの ─────────────────────────────────────
# Claude Code を動かすフォルダ（スキルや書類があるところ）
JARVIS_WORKDIR=~/Desktop

# claude コマンドの場所（launchd では PATH が通らないので絶対パス）
JARVIS_CLAUDE_BIN=claude

# Claude Code の許可モード。auto（安全判定つき自動）/ acceptEdits / default など
JARVIS_PERMISSION_MODE=auto

# ほかの Mac（名前=公開URL をカンマ区切り）。例: macbook=https://jarvis-macbook.example.com
JARVIS_PEERS=

# ── 必要に応じて ───────────────────────────────────────
JARVIS_PORT=8787
# 同時に動かす作業の数
JARVIS_MAX_PARALLEL=2
# 1つの作業の制限時間（分）
JARVIS_TASK_TIMEOUT_MIN=60
# 終わったら Mac の通知センターに出す（1=出す）
JARVIS_MAC_NOTIFY=1
# 終わったら Mac で読み上げる（1=読み上げる。iMac 向け）
JARVIS_MAC_SAY=0
# 終わったら iPhone に通知（ntfy の URL。例: https://ntfy.sh/jarvis-xxxxxxxx）
JARVIS_NTFY_URL=
